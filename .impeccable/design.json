  "narrative": {
    "northStar": "The broker's own screen",
    "overview": "The site looks like the owner's broker app (Trade Republic), with the column discipline of a bank statement. One big number at the top, a clean line chart under it, and positions as ruled rows. Nothing decorates the data: no cards, no shadows, no illustration. Color exists only to say gain or loss. The theme follows the phone: light is the default because dark text on a light ground reads better, and dark matches the broker app at night.",
    "keyCharacteristics": [
      "A big figure whose decimals are set smaller, and which follows the finger on the chart.",
      "Monochrome ink line charts with no tooltip box: the header is the readout.",
      "Ruled rows, right-aligned tabular figures, a true minus sign.",
      "Light and dark from the same tokens, switched by `prefers-color-scheme`."
    ],
    "rules": [
      {
        "name": "The Sign Rule",
        "body": "Gain and loss always carry a `+` or a true minus `−` as well as their color; color is never the only signal.",
        "section": "colors"
      },
      {
        "name": "The Money-Only Color Rule",
        "body": "Green and red are reserved for gain and loss. Nothing else on the page has a hue.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "`font-variant-numeric: tabular-nums` on the whole body; every number column is right-aligned.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** let the header figure be the chart readout.",
      "**Do** show the invested line on any portfolio value chart, so deposits never read as gains.",
      "**Do** keep estimates labeled as estimates (Quote (stima), the footnote)."
    ],
    "donts": [
      "**Don't** add cards, shadows, gradients or icons beside the data.",
      "**Don't** use green or red for anything other than gain and loss.",
      "**Don't** set punctuation tabular: a font whose `tnum` widens `.` and `,` makes figures look typed."
    ]
  }
